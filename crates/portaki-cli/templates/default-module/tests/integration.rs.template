//! Integration-style unit tests with `portaki-test-utils`.
//!
//! The mock host is thread-global, hence `#[serial]` on every test.

use portaki_test_utils::MockContext;
use serial_test::serial;
use {{CRATE_NAME}}::{render_guest_home_card, render_host_main, ModuleConfig};

fn greeting(text: &str) -> ModuleConfig {
    ModuleConfig {
        greeting: text.to_string(),
    }
}

#[test]
#[serial]
fn the_settings_sheet_shows_what_was_saved() {
    MockContext::host()
        .with_config(&greeting("Welcome home"))
        .run(|ctx| {
            let surface = render_host_main(ctx).expect("render");
            let json = serde_json::to_string(&surface).expect("serialize");

            assert!(json.contains("\"main\""));
            assert!(json.contains("Welcome home"));
        });
}

#[test]
#[serial]
fn the_guest_card_greets_with_the_host_wording() {
    MockContext::guest()
        .with_config(&greeting("Welcome home"))
        .run(|ctx| {
            let surface = render_guest_home_card(ctx).expect("render");
            let json = serde_json::to_string(&surface).expect("serialize");

            assert!(json.contains("Welcome home"));
        });
}

#[test]
#[serial]
fn the_guest_card_falls_back_to_the_bundled_wording() {
    MockContext::guest().run(|ctx| {
        let surface = render_guest_home_card(ctx).expect("render");
        let json = serde_json::to_string(&surface).expect("serialize");

        assert!(json.contains("home.card"));
        assert!(json.contains("i18n:home.card.body"));
    });
}
