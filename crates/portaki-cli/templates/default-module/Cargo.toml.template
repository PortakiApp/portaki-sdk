[package]
name = "{{MODULE_NAME}}"
version = "0.1.0"
edition = "2021"
license = "Apache-2.0"
publish = false

[lib]
crate-type = ["cdylib", "rlib"]

[dependencies]
# Une feature par permission : `kv`, `email`, `repo`… quand le module s'en sert. Les réglages
# n'en demandent aucune : la plateforme les garde (`#[portaki_sdk::config]`).
portaki-sdk = { version = "{{SDK_VERSION}}", features = [] }
portaki-connectors = "{{SDK_VERSION}}"
portaki-sdk-macros = "{{SDK_VERSION}}"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
uuid = { version = "1", features = ["serde", "v4", "rng-getrandom"] }
chrono = { version = "0.4", default-features = false, features = ["serde", "clock", "std"] }

[target.'cfg(target_arch = "wasm32")'.dependencies]
extism-pdk = "1.4"

[dev-dependencies]
portaki-test-utils = "{{SDK_VERSION}}"
serial_test = "4"
