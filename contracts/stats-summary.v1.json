{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PortakiApp/portaki-sdk/main/contracts/stats-summary.v1.json",
  "title": "statsSummary query — portaki_sdk::contracts::stats",
  "$ref": "#/$defs/StatsSummary",
  "$defs": {
    "StatsSummaryArgs": {
      "type": "object",
      "required": [
        "propertyId",
        "period",
        "key"
      ],
      "properties": {
        "propertyId": {
          "type": "string",
          "format": "uuid"
        },
        "period": {
          "type": "integer",
          "enum": [
            30,
            90,
            365
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "description": "pathSegment of the property-stats-card surface."
        },
        "views": {
          "oneOf": [
            {
              "$ref": "#/$defs/StatsViews"
            },
            {
              "type": "null"
            }
          ],
          "description": "How guests consulted the module over the window; absent without booklet statistics. Never carries days."
        }
      }
    },
    "StatsViews": {
      "type": "object",
      "description": "Counts only: no stay, no guest, no time of day. Same shape in input.views of the property-stats-detail surface, with days.",
      "required": [
        "opens",
        "surfaces",
        "clicks"
      ],
      "properties": {
        "opens": {
          "type": "integer",
          "minimum": 0,
          "description": "Module surfaces opened, once per surface and booklet session."
        },
        "surfaces": {
          "type": "object",
          "description": "opens by manifest surface id.",
          "propertyNames": {
            "pattern": "^[a-z0-9/_-]{1,64}$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "clicks": {
          "type": "object",
          "description": "Taps leaving the booklet, by kind.",
          "propertyNames": {
            "enum": [
              "call",
              "directions",
              "mail",
              "link"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "days": {
          "type": "array",
          "description": "Active UTC days, oldest first; detail surface only.",
          "items": {
            "type": "object",
            "required": [
              "date",
              "opens",
              "clicks"
            ],
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "opens": {
                "type": "integer",
                "minimum": 0
              },
              "clicks": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "StatsSummary": {
      "type": "object",
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "type": "string",
          "maxLength": 12
        },
        "label": {
          "$ref": "#/$defs/I18nText"
        },
        "attention": {
          "oneOf": [
            {
              "$ref": "#/$defs/StatsAttention"
            },
            {
              "type": "null"
            }
          ]
        },
        "trend": {
          "oneOf": [
            {
              "$ref": "#/$defs/StatsTrend"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "StatsAttention": {
      "type": "object",
      "required": [
        "level",
        "text"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "action",
            "warning"
          ]
        },
        "text": {
          "$ref": "#/$defs/I18nText"
        }
      }
    },
    "StatsTrend": {
      "type": "object",
      "required": [
        "delta",
        "direction",
        "good"
      ],
      "properties": {
        "delta": {
          "type": "string"
        },
        "direction": {
          "type": "string",
          "enum": [
            "up",
            "down"
          ]
        },
        "good": {
          "type": "boolean",
          "description": "Whether that direction is good news."
        }
      }
    },
    "I18nText": {
      "type": "object",
      "description": "Display text: fr and en required, other locales beside them.",
      "required": [
        "fr",
        "en"
      ],
      "properties": {
        "fr": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
